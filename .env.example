# Copy to .env and adjust:  cp .env.example .env

# Aspia version to run. The updater changes it automatically when a new release is out.
ASPIA_VERSION=3.0.32

# Public IP address (or DNS name) of this server - clients connect to the relay through it.
# "auto" detects it on every start (handy for a dynamic IP).
EXTERNAL_IP=203.0.113.10

# Absolute path of this directory on the host. The updater mounts it at the same path,
# so it MUST match, e.g. /opt/aspia or /volume1/docker/aspia on Synology.
ASPIA_DIR=/opt/aspia

# Compose project name.
COMPOSE_PROJECT_NAME=aspia

# Time zone of the containers (logs, UPDATE_TIME).
TZ=Europe/Moscow

# ---------- Automatic updates ----------

# Daily check for a new Aspia release (local time, TZ above).
UPDATE_TIME=04:00
# Install a release only when it is at least this many days old (0 = right away).
MIN_AGE_DAYS=2
# Backups of data/config and data/database kept in ./backups.
KEEP_BACKUPS=10
# Aspia log files older than this many days are deleted.
LOG_RETENTION_DAYS=30
# The updater updates its own image as well (1/0).
SELF_UPDATE=1

# ---------- Images ----------

# Registry images (default). To build locally instead, uncomment:
# COMPOSE_FILE=compose.yaml:compose.build.yaml
ASPIA_IMAGE=ghcr.io/sinitsada/aspia-server
UPDATER_IMAGE=ghcr.io/sinitsada/aspia-server-updater
