# Lightweight Aspia Router + Relay for MikroTik RouterOS (fits into the built-in flash): the binaries
# are compressed with UPX (bin-upx/<arch>/), the system is reduced to the commands the scripts use.
# Uncompressed binaries are needed in bin/<arch>/ too: their libraries are found with ldd.
ARG DEBIAN_TAG=bookworm-slim
FROM debian:${DEBIAN_TAG} AS rootfs
ARG TARGETARCH
ARG TARGETVARIANT

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl jq tzdata procps \
        libdbus-1-3 mawk util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY bin/${TARGETARCH}${TARGETVARIANT}/aspia_router bin/${TARGETARCH}${TARGETVARIANT}/aspia_relay /tmp/aspia/
COPY mikrotik/make-rootfs.sh /tmp/make-rootfs.sh
RUN bash /tmp/make-rootfs.sh /rootfs

FROM scratch

ARG ASPIA_VERSION
# 0 for the 3.0.x images: 3.1 dropped the 2.x hosts, so they are updated only on request
# (aspia_update --check). The variable can be changed when the container is created.
ARG AUTO_UPDATE=1
ARG TARGETARCH
ARG TARGETVARIANT

LABEL org.opencontainers.image.title="Aspia Server (MikroTik)" \
      org.opencontainers.image.description="Aspia Router + Relay for MikroTik RouterOS, self-updating" \
      org.opencontainers.image.version="${ASPIA_VERSION}" \
      org.opencontainers.image.source="https://github.com/dchapyshev/aspia" \
      org.opencontainers.image.licenses="GPL-3.0"

COPY --from=rootfs /rootfs/ /

ENV PATH=/usr/local/bin:/usr/bin:/bin \
    ASPIA_VERSION=${ASPIA_VERSION} \
    AUTO_UPDATE=${AUTO_UPDATE} \
    LANG=C.UTF-8 \
    ASSET_FLAVOR=-upx \
    KEEP_VERSIONS=1

COPY bin-upx/${TARGETARCH}${TARGETVARIANT}/aspia_router bin-upx/${TARGETARCH}${TARGETVARIANT}/aspia_relay /opt/aspia/${ASPIA_VERSION}/
COPY aspia_start aspia_health aspia_update /usr/bin/
COPY aspia_router.wrapper /usr/local/bin/aspia_router
COPY aspia_relay.wrapper /usr/local/bin/aspia_relay

# 8060 hosts 2.x | 8061 hosts 3.x | 8062 clients | 8063 relay <-> router | 8065/udp STUN | 8070 relay peers
EXPOSE 8060 8061 8062 8063 8065/udp 8070

CMD ["/usr/bin/aspia_start"]
